// Prisma Schema - Sistema Contagie Beta
// Sistema de gestao de ministerios e escalas para igreja

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  COORDINATOR
  LEADER
  COMMUNICATION
  VOLUNTEER
}

enum EventType {
  SUNDAY_MORNING
  SUNDAY_EVENING
  SPECIAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum EventItemType {
  WELCOME       // Boas-vindas
  WORSHIP       // Bloco de louvor
  PRAYER        // Oracao
  READING       // Leitura Biblica
  ANNOUNCEMENTS // Avisos
  OFFERING      // Dizimos e Ofertas
  PREACHING     // Pregacao/Palavra
  COMMUNION     // Santa Ceia
  VIDEO         // Video/Midia
  SPECIAL       // Participacao Especial
  TRANSITION    // Transicao/Intervalo
  OTHER         // Outros
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  PRESENTATION
}

enum MediaCategory {
  ANNOUNCEMENTS
  PREACHING
  OTHER
}

// ============================================
// AUTH.JS MODELS (Prisma Adapter Pattern)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // Hash da senha para login com credenciais
  role          UserRole  @default(VOLUNTEER)
  cpf           String?   @unique
  phone         String?
  birthDate     DateTime?
  inviteToken   String?   @unique
  inviteExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relacionamentos Auth.js
  accounts Account[]
  sessions Session[]

  // Relacionamentos do Sistema
  ministryMemberships MinistryMember[]
  leaderOfMinistries  Ministry[]       @relation("MinistryLeader")
  schedules           Schedule[]
  bandMemberships     BandMember[]
  uploadedMedia       Media[]
  notifications       Notification[]
  blockedDates        BlockedDate[]
  eventItems          EventItem[]      @relation("EventItemResponsible")
  assignmentLogs      AssignmentLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// MINISTRY (MINISTERIO)
// ============================================

model Ministry {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  leaderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  leader           User?                     @relation("MinistryLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members          MinistryMember[]
  schedules        Schedule[]
  positions        MinistryPosition[]
  vacancies        EventVacancy[]
  autoAssignConfig MinistryAutoAssignConfig?
  assignmentLogs   AssignmentLog[]

  @@index([leaderId])
  @@map("ministries")
}

model MinistryPosition {
  id          String   @id @default(cuid())
  ministryId  String
  name        String   // Ex: "Mesa de Som", "Guitarra", "Recepcionista"
  description String?
  createdAt   DateTime @default(now())

  ministry  Ministry               @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  members   MemberPosition[]
  vacancies EventVacancy[]

  @@unique([ministryId, name])
  @@index([ministryId])
  @@map("ministry_positions")
}

model MinistryMember {
  id         String   @id @default(cuid())
  userId     String
  ministryId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relacionamentos
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministry  Ministry         @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  positions MemberPosition[]

  @@unique([userId, ministryId])
  @@index([userId])
  @@index([ministryId])
  @@index([active])
  @@map("ministry_members")
}

// Tabela de juncao para relacao many-to-many entre MinistryMember e MinistryPosition
model MemberPosition {
  id         String   @id @default(cuid())
  memberId   String
  positionId String
  assignedAt DateTime @default(now())

  member   MinistryMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  position MinistryPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([memberId, positionId])
  @@index([memberId])
  @@index([positionId])
  @@map("member_positions")
}

// ============================================
// EVENT (EVENTO/CULTO)
// ============================================

model EventTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  items       Json // Array de itens padrao do template
  createdAt   DateTime @default(now())

  // Relacionamentos
  events Event[]

  @@map("event_templates")
}

model Event {
  id         String      @id @default(cuid())
  name       String
  type       EventType
  date       DateTime    @db.Date
  startTime  DateTime    @db.Time()
  endTime    DateTime?   @db.Time()
  status     EventStatus @default(DRAFT)
  templateId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Campos de Recorrencia
  isRecurring       Boolean            @default(false)
  recurrencePattern RecurrencePattern?
  recurrenceEndDate DateTime?          @db.Date
  parentEventId     String?

  // Relacionamentos
  template       EventTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items          EventItem[]
  schedules      Schedule[]
  setlists       Setlist[]
  media          Media[]
  vacancies      EventVacancy[]
  assignmentLogs AssignmentLog[]

  // Self-relation para series de eventos
  parentEvent Event?  @relation("EventSeries", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents Event[] @relation("EventSeries")

  @@index([date])
  @@index([type])
  @@index([status])
  @@index([templateId])
  @@index([parentEventId])
  @@map("events")
}

model EventItem {
  id              String        @id @default(cuid())
  eventId         String
  order           Int
  type            EventItemType
  title           String
  description     String?       @db.Text
  durationMinutes Int?
  responsibleId   String?

  // Campos adicionais
  bibleReference String?  // Referencia biblica (Ex: "Joao 3:16-21")
  mediaUrl       String?  // Link para video/midia externa
  notes          String?  @db.Text // Notas internas para a equipe
  isPublic       Boolean  @default(true) // Visivel para membros?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relacionamentos
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responsible  User?     @relation("EventItemResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  setlistItems Setlist[] // Musicas associadas a este bloco de louvor

  @@index([eventId])
  @@index([order])
  @@index([responsibleId])
  @@map("event_items")
}

// ============================================
// EVENT VACANCY (VAGAS DO EVENTO)
// ============================================

model EventVacancy {
  id         String   @id @default(cuid())
  eventId    String
  ministryId String
  positionId String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  // Relacionamentos
  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry Ministry         @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  position MinistryPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@unique([eventId, ministryId, positionId])
  @@index([eventId])
  @@index([ministryId])
  @@index([positionId])
  @@map("event_vacancies")
}

// ============================================
// SCHEDULE (ESCALA)
// ============================================

model Schedule {
  id             String         @id @default(cuid())
  eventId        String
  ministryId     String
  userId         String
  vacancyId      String? // Referencia a vaga especifica
  position       String? // Funcao especifica na escala (legado)
  status         ScheduleStatus @default(PENDING)
  confirmedAt    DateTime?
  declinedReason String?        @db.Text
  createdAt      DateTime       @default(now())

  // Relacionamentos
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry Ministry      @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy  EventVacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@unique([eventId, ministryId, userId])
  @@index([eventId])
  @@index([ministryId])
  @@index([userId])
  @@index([vacancyId])
  @@index([status])
  @@map("schedules")
}

// ============================================
// AUTO-ASSIGN (DISTRIBUICAO AUTOMATICA)
// ============================================

model MinistryAutoAssignConfig {
  id                String    @id @default(cuid())
  ministryId        String    @unique
  enabled           Boolean   @default(false)
  autoAssignUntil   DateTime? // Ate quando distribuir automaticamente
  avoidConsecutive  Boolean   @default(true) // Evitar eventos consecutivos
  maxEventsPerMonth Int? // Limite de escalas por mes por membro
  rotationWeight    Int       @default(40) // Peso da rotacao (0-100)
  availabilityWeight Int      @default(40) // Peso da disponibilidade (0-100)
  updatedAt         DateTime  @updatedAt

  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  @@map("ministry_auto_assign_configs")
}

model AssignmentLog {
  id           String   @id @default(cuid())
  eventId      String
  ministryId   String
  userId       String
  vacancyId    String?
  score        Int // Score final (0-100)
  scoreDetails Json? // Breakdown: {rotation: 40, availability: 50, ...}
  reason       String? // "auto" | "manual"
  assignedAt   DateTime @default(now())

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ministry Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([ministryId])
  @@index([userId])
  @@index([assignedAt])
  @@map("assignment_logs")
}

// ============================================
// BAND (BANDA)
// ============================================

model Band {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Relacionamentos
  members BandMember[]

  @@index([active])
  @@map("bands")
}

model BandMember {
  id         String   @id @default(cuid())
  bandId     String
  userId     String
  instrument String // Ex: "Guitarra", "Baixo", "Bateria", "Vocal"
  createdAt  DateTime @default(now())

  // Relacionamentos
  band Band @relation(fields: [bandId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bandId, userId])
  @@index([bandId])
  @@index([userId])
  @@map("band_members")
}

// ============================================
// SONG (MUSICA)
// ============================================

model Song {
  id             String    @id @default(cuid())
  name           String
  artist         String?
  defaultKey     String? // Tom padrao (Ex: "C", "G", "Am")
  lyrics         String?   @db.Text
  chordLink      String? // Link para cifra externa
  tags           String[] // Array de tags (Ex: ["adoracao", "rapido", "natal"])
  propresenterId String? // ID no ProPresenter
  lastPlayedAt   DateTime?
  playCount      Int       @default(0)
  createdAt      DateTime  @default(now())

  // Relacionamentos
  setlists Setlist[]

  @@index([name])
  @@index([artist])
  @@index([tags])
  @@index([lastPlayedAt])
  @@map("songs")
}

model Setlist {
  id          String   @id @default(cuid())
  eventId     String
  eventItemId String?  // Bloco de louvor especifico (se associado a um EventItem)
  order       Int
  songId      String
  key         String?  // Tom especifico para este evento (pode diferir do padrao)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  // Relacionamentos
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  song      Song       @relation(fields: [songId], references: [id], onDelete: Cascade)
  eventItem EventItem? @relation(fields: [eventItemId], references: [id], onDelete: SetNull)

  @@unique([eventId, eventItemId, order])
  @@index([eventId])
  @@index([eventItemId])
  @@index([songId])
  @@map("setlists")
}

// ============================================
// MEDIA (MIDIA/ARQUIVOS)
// ============================================

model Media {
  id           String        @id @default(cuid())
  eventId      String?
  type         MediaType
  url          String
  filename     String?
  category     MediaCategory @default(OTHER)
  uploadedById String?
  createdAt    DateTime      @default(now())

  // Relacionamentos
  event      Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([type])
  @@index([category])
  @@index([uploadedById])
  @@map("media")
}

// ============================================
// NOTIFICATION (NOTIFICACOES)
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // Tipo flexivel (Ex: "SCHEDULE_REMINDER", "NEW_EVENT", etc)
  title     String
  message   String    @db.Text
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  // Relacionamentos
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// BLOCKED DATE (DATAS BLOQUEADAS)
// ============================================

model BlockedDate {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  // Relacionamentos
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@map("blocked_dates")
}

// ============================================
// APP SETTINGS (CONFIGURACOES DO SISTEMA)
// ============================================

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
